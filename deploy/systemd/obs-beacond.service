[Unit]
Description=Cairn OBS server
Documentation=https://cairnobs.org
After=network-online.target
Wants=network-online.target

[Service]
User=obs-beacon
Group=obs-beacon
ExecStart=/usr/bin/obs-beacond -config /etc/obs-beacon/obs-beacond.yaml
Restart=always
RestartSec=5
MemoryMax=512M
StateDirectory=obs-beacon
# Ports 80 and 443 for tls.acme; nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
