# Node / SvelteKit (web/ has its own more detailed .gitignore too)
web/node_modules/
web/build/
web/.svelte-kit/

# Dev-only generated secrets
hack/dev-certs/out/

# Local overrides that may carry real credentials (e.g. a real OIDC/SAML
