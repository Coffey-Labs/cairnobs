{
  "name": "match_ne_matches_when_different",
  "description": "ne is the complement of eq, including for absent fields.",
  "rules": [
    {
      "match": [
        {
          "field": "service",
          "op": "ne",
          "value": "keep-me"
        }
      ],
      "actions": [
        {
          "action": "drop"
        }
      ]
    }
  ],
  "inputs": [
    {
      "timestamp_unix_nano": 1000,
      "host": "h1",
      "service": "keep-me",
      "severity": "SEVERITY_INFO",
      "message": "a",
      "attributes": {}
    },
    {
      "timestamp_unix_nano": 2000,
      "host": "h1",
      "service": "other",
      "severity": "SEVERITY_INFO",
      "message": "b",
      "attributes": {}
    }
  ],
  "expect": [
    {
      "timestamp_unix_nano": 1000,
      "host": "h1",
      "service": "keep-me",
      "severity": "SEVERITY_INFO",
      "message": "a",
      "attributes": {}
    }
  ]
}
