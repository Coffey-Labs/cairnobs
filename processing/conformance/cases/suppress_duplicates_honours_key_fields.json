{
  "name": "suppress_duplicates_honours_key_fields",
  "description": "With key_fields, identical messages from different hosts are not duplicates of each other.",
  "rules": [
    {
      "match": [],
      "actions": [
        {
          "action": "suppress_duplicates",
          "window_ms": 5000,
          "key_fields": [
            "host",
            "message"
          ]
        }
      ]
    }
  ],
  "inputs": [
    {
      "timestamp_unix_nano": 0,
      "host": "h1",
      "service": "s1",
      "severity": "SEVERITY_INFO",
      "message": "same",
      "attributes": {}
    },
    {
      "timestamp_unix_nano": 1000000,
      "host": "h2",
      "service": "s1",
      "severity": "SEVERITY_INFO",
      "message": "same",
      "attributes": {}
    },
    {
      "timestamp_unix_nano": 2000000,
      "host": "h1",
      "service": "s1",
      "severity": "SEVERITY_INFO",
      "message": "same",
      "attributes": {}
    }
  ],
  "expect": [
    {
      "timestamp_unix_nano": 0,
      "host": "h1",
      "service": "s1",
      "severity": "SEVERITY_INFO",
      "message": "same",
      "attributes": {}
    },
    {
      "timestamp_unix_nano": 1000000,
      "host": "h2",
      "service": "s1",
      "severity": "SEVERITY_INFO",
      "message": "same",
      "attributes": {}
    }
  ]
}
