{
  "name": "rename_moves_an_attribute",
  "description": "rename removes the source key and creates the destination.",
  "rules": [
    {
      "match": [],
      "actions": [
        {
          "action": "rename",
          "from": "attributes.old",
          "to": "attributes.new"
        }
      ]
    }
  ],
  "inputs": [
    {
      "timestamp_unix_nano": 1000,
      "host": "h1",
      "service": "s1",
      "severity": "SEVERITY_INFO",
      "message": "a",
      "attributes": {
        "old": "v"
      }
    }
  ],
  "expect": [
    {
      "timestamp_unix_nano": 1000,
      "host": "h1",
      "service": "s1",
      "severity": "SEVERITY_INFO",
      "message": "a",
      "attributes": {
        "new": "v"
      }
    }
  ]
}
